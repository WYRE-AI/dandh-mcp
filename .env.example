# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
#
# Configure the REST service, the XML service, or both. Each set is
# all-or-none: a partially filled set is a configuration error.

# --- REST (Customer Order Management API v2, OAuth2 client credentials) ---
# Create an application at https://apiportal.dandh.com (test:
# https://test.apiportal.dandh.com), tick "Customer Order Management API",
# then generate OAuth credentials. REST onboarding goes through your D&H rep.
DANDH_CLIENT_ID=
DANDH_CLIENT_SECRET=
# Your 10-digit D&H account number.
DANDH_ACCOUNT_NUMBER=
# us (D&H US), ca (D&H Canada) or dsc (DSC). Default: us
# DANDH_COMPANY=us

# --- XML (dandh.com / dandh.ca UserCode + Password) ---
# Request XML access in My D&H -> D&H Automation Services.
DANDH_XML_USER_CODE=
DANDH_XML_PASSWORD=
# us (dandh.com) or ca (dandh.ca). Default: us
# DANDH_XML_COUNTRY=us

# Optional override of the XML endpoint. https only, on dandh.com / dandh.ca or
# a subdomain, no username/password, no port. Anything else stops startup.
# DANDH_XML_URL=https://www.dandh.com/dhXML/xmlDispatch

# --- Order caps (positive numbers; an invalid value stops startup) ---
# The order tools only preview unless the caller passes confirm: true; these
# caps apply to previews and real orders alike.
# Max total lines in one order (all shipments/items). Default: 25
# DANDH_MAX_ORDER_LINES=25
# Max quantity on a single line. Default: 100
# DANDH_MAX_LINE_QUANTITY=100
# Max total order value (sum of qty x unit price), in the account currency. Default: 5000
# DANDH_MAX_ORDER_VALUE=5000
# Max caller-supplied unit price (sanity check). Default: 25000
# DANDH_MAX_UNIT_PRICE=25000

# Key for the order preview confirmToken. Default: random per process. Set the same value on every replica
# if a preview and its confirm can reach different ones.
# DANDH_CONFIRM_SECRET=

# production (default) or test. Selects the REST OAuth/API hosts only.
# DANDH_ENVIRONMENT=production

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address for HTTP. When CONDUIT_S2S_SECRET is set and MCP_HTTP_HOST is
# unset, the server binds 0.0.0.0 (container deploys). Set 127.0.0.1 to bind
# loopback. The insecure-dev bypass ignores a non-loopback value and binds
# 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (so a copied example
# cannot forge X-Gateway-S2S). Compose will not start when it is unset.
# Generate a value with: openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# A placeholder CONDUIT_S2S_SECRET still refuses to start.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (credentials
# required on every request as X-DandH-* headers; no env fallback). The
# container image and the compose service set gateway. Stdio ignores this and
# reads DANDH_* from the environment.
# AUTH_MODE=env

LOG_LEVEL=info
