# D&H MCP environment. Read-only server: no tool places orders.
# The D&H hosts are fixed in code; there is no base URL setting.

# --- Credentials (stdio, and HTTP only when AUTH_MODE=env) ---
# Gateway mode ignores all of these; credentials arrive per request on the
# X-DandH-* headers. Configure the REST set, the XML set, or both. Each set
# is all-or-none: a partially filled set is a configuration error.

# REST (Customer Order Management API v2, OAuth2 client credentials).
# Create an application at https://apiportal.dandh.com, tick "Customer Order
# Management API", then generate OAuth credentials (confidential client).
DANDH_CLIENT_ID=
DANDH_CLIENT_SECRET=
# Your 10-digit D&H account number.
DANDH_ACCOUNT_NUMBER=
# us (D&H US), ca (D&H Canada) or dsc (DSC). Default: us
# DANDH_COMPANY=us

# XML (dandh.com / dandh.ca UserCode + Password; request XML access in
# My D&H -> D&H Automation Services).
DANDH_XML_USER_CODE=
DANDH_XML_PASSWORD=
# us (dandh.com) or ca (dandh.ca). Default: us
# DANDH_XML_COUNTRY=us

# --- Deployment settings (not credentials) ---
# production (default) or test: picks one of two hard-coded REST host pairs
# (auth.dandh.com + api.dandh.com, or the test.* pair). XML is unaffected.
# DANDH_ENVIRONMENT=production

# Tool tiers to expose. Every tool is read-only, so the only tier is read.
# In HTTP mode Conduit may send X-Conduit-Tool-Tiers to narrow (never widen)
# this set per request; an empty header exposes no tools.
# DANDH_TOOL_TIERS=read

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address for MCP_TRANSPORT=http. Defaults to 127.0.0.1. The container
# image sets 0.0.0.0 and requires CONDUIT_S2S_SECRET.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Optional Host-header allowlist for /mcp (comma-separated, case-insensitive,
# with or without port). Requests with any other Host get 403. Unset = no check.
# MCP_ALLOWED_HOSTS=dandh-mcp.internal,localhost

# Required to start the HTTP transport. Leave empty here; never commit a value.
# Generate with: openssl rand -hex 32
# Startup refuses secrets shorter than 32 characters, known placeholders, and
# repeated patterns. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Exactly 1 starts HTTP without CONDUIT_S2S_SECRET,
# skips the X-Gateway-S2S check, and binds 127.0.0.1 regardless of
# MCP_HTTP_HOST. A placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (DANDH_* above) or gateway (X-DandH-* on
# every request; no env fallback). The container image sets gateway. stdio
# reads DANDH_* unless AUTH_MODE=gateway.
# AUTH_MODE=env

# DANDH_REQUEST_TIMEOUT_MS=30000
# DANDH_MAX_RESPONSE_CHARS=60000
# DANDH_MAX_UPSTREAM_BYTES=4194304
# LOG_LEVEL=info
